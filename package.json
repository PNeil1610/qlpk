{
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "docker:up": "docker compose -f docker-compose.keycloak.yml up -d",
        "docker:down": "docker compose -f docker-compose.keycloak.yml down",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:auto": "npm run docker:up && playwright test",
        "test:e2e:ui:auto": "npm run docker:up && playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@popperjs/core": "^2.11.6",
        "axios": "^1.1.2",
        "bootstrap": "^5.2.3",
        "laravel-vite-plugin": "^0.7.2",
        "sass": "^1.56.1",
        "vite": "^4.0.0"
    }
}
